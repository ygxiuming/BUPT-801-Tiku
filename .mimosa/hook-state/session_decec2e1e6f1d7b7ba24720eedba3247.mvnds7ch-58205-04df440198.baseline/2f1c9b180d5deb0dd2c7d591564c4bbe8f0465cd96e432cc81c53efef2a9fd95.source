// 共享渲染组件：两套前端（试卷展示 / 刷题）共用
window.BUPT801 = window.BUPT801 || {};
(function (B) {
  // ---- 数学公式渲染（KaTeX auto-render）----
  B.renderMath = function (el) {
    if (!el || !window.renderMathInElement) return;
    renderMathInElement(el, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false }
      ],
      throwOnError: false
    });
  };

  // ---- SVG 图 ----
  B.figureSvg = function (year, key) {
    var f = B.figures && B.figures[String(year)];
    return f && f[key] ? f[key] : '';
  };
  B.figBlock = function (year, key, caption) {
    var svg = B.figureSvg(year, key);
    if (!svg) return '';
    return '<figure class="figblock">' + svg +
      (caption ? '<figcaption>' + caption + '</figcaption>' : '') + '</figure>';
  };

  // ---- 题干空格加粗：（12）→ <strong>（12）</strong> ----
  B.boldBlanks = function (s) {
    return s.replace(/（(\d+)）/g, '（<strong class="blank">$1</strong>）');
  };

  // ---- 选择题选项表 ----
  B.optionsTable = function (opts) {
    var keys = ['A', 'B', 'C', 'D'];
    var cells = keys.filter(function (k) { return opts[k] !== undefined; })
      .map(function (k) { return '<td><span class="optkey">(' + k + ')</span>' + opts[k] + '</td>'; });
    var rows = '';
    for (var i = 0; i < cells.length; i += 2) {
      rows += '<tr>' + cells[i] + (cells[i + 1] || '<td></td>') + '</tr>';
    }
    return '<table class="opt-table"><tbody>' + rows + '</tbody></table>';
  };

  // ---- 选择题解析块 ----
  B.choiceExpHtml = function (q, opts) {
    var h = '<div class="ans ans-choice" data-ans="' + q.answer + '">';
    h += '<div class="ans-title">答案：<span class="ans-letter">' + q.answer + '</span>' +
      '<span class="ans-meta">' + B.chapterLabel(q) + '</span></div>';
    h += '<div class="ans-concl">' + (q.exp.concl || '') + '</div>';
    h += '<div class="ans-opts">';
    ['A', 'B', 'C', 'D'].forEach(function (k) {
      if (!q.exp.opts || !q.exp.opts[k]) return;
      var right = (k === q.answer);
      h += '<div class="opt-exp' + (right ? ' right' : '') + '"><b>(' + k + ')</b> ' + q.exp.opts[k] + '</div>';
    });
    h += '</div>';
    if (q.exp.note) h += '<div class="ans-note"><b>💡 提示：</b>' + q.exp.note + '</div>';
    h += '</div>';
    return h;
  };

  // ---- 大题解析块 ----
  B.bigSolHtml = function (q, year) {
    var h = '<div class="ans ans-big" data-ans="' + q.num + '">';
    h += '<div class="ans-title">参考解析<span class="ans-meta">' + B.chapterLabel(q) + '</span></div>';
    if (q.sol.intro) h += '<div class="ans-concl">' + q.sol.intro + '</div>';
    (q.sol.steps || []).forEach(function (st) {
      h += '<details class="sol-step" open><summary>' + st.q + '</summary><div class="step-body">';
      (st.body || []).forEach(function (p) { h += '<div class="step-line">' + p + '</div>'; });
      if (st.fig) h += B.figBlock(year, st.fig);
      if (st.ans) h += '<div class="step-ans">' + st.ans + '</div>';
      h += '</div></details>';
    });
    if (q.sol.summary) h += '<div class="sol-summary"><b>答案汇总：</b>' + q.sol.summary + '</div>';
    if (q.sol.pitfalls) h += '<div class="ans-note"><b>💡 易错点：</b>' + q.sol.pitfalls + '</div>';
    h += '</div>';
    return h;
  };

  B.chapterLabel = function (q) {
    var ch = (B.chapters || []).find(function (c) { return c.id === q.chapter; });
    return (ch ? ch.name : '') + (q.point ? ' · ' + q.point : '');
  };

  B.tagChips = function (tags) {
    return (tags || []).map(function (t) { return '<span class="chip">' + t + '</span>'; }).join('');
  };
})(window.BUPT801);
