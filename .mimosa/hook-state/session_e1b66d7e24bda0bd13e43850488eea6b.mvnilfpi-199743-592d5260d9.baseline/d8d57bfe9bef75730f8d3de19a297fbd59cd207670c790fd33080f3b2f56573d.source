    return s + '</svg>'


def fig_encoder():
    """b=uG₁ → c=b*g 两级编码框图（2025 第九题）。

    版式要点（旧版的三处遮挡：b 标签压箭头、G₂ 标签被抽头竖线穿过、⊕ 画成
    "圆圈+⊕字符"双重圆）已全部重排：
      · 文字标签左右各留 ≥8px 空隙，箭头不出头压字；
      · 抽头母线在延迟线正上方，G₂ 标签放在虚线框内左下角空位；
      · ⊕ 用「圆 + 十字线」绘制（不用字符），交叉点即模二加。
    虚线框在信号线穿越处留缺口，避免线与框线交叉。
    """
    X0, X1 = 406, 874          # G₂ 虚线框左右边界
    YB, YBUS = 96, 50          # 信号线 / 抽头母线
    YT, YD = 26, 138           # 框上/下边界
    s = HEAD.format(w=1070, h=150) + marker('arC')

    def dashed(x1, y1, x2, y2):
        return line(x1, y1, x2, y2, width=1.3, dash='6,4')

    # 虚线框：左边界给输入线让路、右边界给输出线让路，线不压框
    s += dashed(X0, YT, X1, YT) + dashed(X0, YD, X1, YD)                    # 上下边
    s += dashed(X0, YT, X0, YB - 7) + dashed(X0, YB + 7, X0, YD)            # 左边（缺口）
    s += dashed(X1, YT, X1, YBUS - 6) + dashed(X1, YBUS + 6, X1, YD)        # 右边（缺口）
    s += text(414, YD - 7, 'G_2', anchor='start', style='b')

    # ---- u → G₁ → b ----
    s += text(12, YB + 5, 'u=(u_0u_1u_2u_3)', anchor='start', style='i')
    s += line(112, YB, 148, YB, marker='arC')
    s += rect(151, YB - 18, 44, 36) + text(173, YB + 5, 'G_1', style='b')
    s += line(197, YB, 228, YB, marker='arC')
    s += text(234, YB + 5, 'b=(b_0b_1b_2b_3)', anchor='start', style='i')

    # ---- b → 延迟线 D D D（进入框内接到 D₁）----
    s += line(332, YB, 441, YB, marker='arC')
    for x in (444, 516, 588):
        s += rect(x, YB - 16, 36, 32) + text(x + 18, YB + 5, 'D', style='i')
    s += line(480, YB, 513, YB, marker='arC')
    s += line(552, YB, 585, YB, marker='arC')
    s += line(624, YB, 690, YB)

    # ---- 抽头：输入(g0=1)、1D(g1=1)、3D(g3=1) → 模二加 ----
    for x in (420, 498, 690):
        s += dot(x, YB, 2.6) + line(x, YB, x, YBUS) + dot(x, YBUS, 2.6)
    s += line(420, YBUS, 728, YBUS)
    s += circle(740, YBUS, 12)
    s += line(731, YBUS, 749, YBUS) + line(740, YBUS - 9, 740, YBUS + 9)
    s += line(752, YBUS, 884, YBUS, marker='arC')          # 穿框右边界缺口输出 c
    s += text(892, YBUS + 5, 'c=(c_0c_1c_2c_3c_4c_5c_6)', anchor='start', style='i')
    return s + '</svg>'


GRAY = {8: '100', 1: '000', 2: '001', 3: '011', 4: '010', 5: '110', 6: '111', 7: '101'}


def pt(cx, cy, r, deg):
    return (cx + r * math.cos(math.radians(deg)), cy - r * math.sin(math.radians(deg)))


def fig_psk8():
    cx, cy, R = 200, 200, 120
    s = HEAD.format(w=400, h=400) + circle(cx, cy, R)
    for k in range(8):  # ML判决边界 22.5°+45k
        a = 22.5 + 45 * k
        x2, y2 = pt(cx, cy, 155, a)
        s += line(cx, cy, x2, y2, dash='5,4', color='#555')
    for i in range(1, 9):
        deg = 45 * i % 360
        px, py = pt(cx, cy, R, deg)
        s += dot(px, py, 4.5)
        lx, ly = pt(cx, cy, 92, deg)
        s += text(lx, ly + 5, f's{i}', style='i')
        dx, dy = pt(cx, cy, 60, deg)
        s += text(dx, dy + 5, f'D{i}', size=13, color='#555')
        bx, by = pt(cx, cy, 150, deg)
        s += text(bx, by + 5, GRAY[i], size=13, color='#333')
    return s + '</svg>'


def fig_psk8new():
    cx, cy, S = 210, 210, 110
    tpx = 0.580 * S  # 三重点（轴上）
    s = HEAD.format(w=430, h=430)
    s += circle(cx, cy, S, dash='4,4', color='#999', width=1.2)
    s += circle(cx, cy, S / 2, dash='2,4', color='#bbb', width=1.0)
    inner = {1: 45, 3: 135, 5: 225, 7: 315}
    outer = {8: 0, 2: 90, 4: 180, 6: 270}
    for dx, dy in ((tpx, 0), (-tpx, 0), (0, tpx), (0, -tpx)):
        s += line(cx, cy, cx + dx, cy + dy, color='#555', dash='5,4')
    rays = [
        ((tpx, 0), (1.35, -1.25)), ((tpx, 0), (1.35, 1.25)),
        ((-tpx, 0), (-1.35, -1.25)), ((-tpx, 0), (-1.35, 1.25)),
        ((0, tpx), (1.25, -1.35)), ((0, tpx), (-1.25, -1.35)),
        ((0, -tpx), (1.25, 1.35)), ((0, -tpx), (-1.25, 1.35)),
    ]
    for (sx, sy), (ex, ey) in rays:
        s += line(cx + sx, cy + sy, cx + ex * S, cy + ey * S, color='#555', dash='5,4')
    lbl = {8: (16, 5, 's₈ 100'), 2: (14, -8, 's₂ 001'), 4: (-18, 5, 's₄ 010'), 6: (-16, 16, 's₆ 111'),
           1: (12, -6, 's₁ 000'), 3: (-14, -6, 's₃ 011'), 5: (-16, 14, 's₅ 110'), 7: (12, 14, 's₇ 101')}
    allp = {**inner, **outer}
    for i, deg in allp.items():
        r = S / 2 if i in inner else S
        px, py = pt(cx, cy, r, deg)
        s += dot(px, py, 4.5)
        ox, oy, t = lbl[i]
        s += text(px + ox, py + oy, t, size=13)
    for i, deg in allp.items():
        r = S / 2 if i in inner else S
        dx, dy = pt(cx, cy, r * 0.72, deg)
        s += text(dx, dy + 5, f'D{i}', size=13, color='#555')
    s += text(215, 420, '内圆r=1/2（s₁s₃s₅s₇），外圆r=1；虚线圆为原单位圆', size=12, color='#777')
    return s + '</svg>'


def gauss_pts(cx, base_y, peak, sigma, x0, x1, step=6):
    pts = []
    x = x0
    while x <= x1:
        y = base_y - peak * math.exp(-((x - cx) ** 2) / (2 * sigma ** 2))
        pts.append((x, y))
        x += step
    return pts


def fig_ookpdf():
    base, sigma, peak = 200, 45, 125
    c0, c1, vt = 140, 400, 270
    s = HEAD.format(w=560, h=240) + marker('arD')
    s += line(30, base, 530, base, marker='arD')
    s += line(140, base, 140, 40, color='#999', dash='2,3')
    s += line(400, base, 400, 40, color='#999', dash='2,3')
    s += poly(gauss_pts(c0, base, peak, sigma, c0 - 130, c0 + 130))
    s += poly(gauss_pts(c1, base, peak, sigma, c1 - 130, c1 + 130))
    s += line(vt, base, vt, 55, width=1.6, dash='7,4', color='#c0392b')
    s += text(vt, 45, 'V_T=E₁/2', style='i', color='#c0392b')
    s += text(c0 - 55, 62, 'f(y|"0")', style='i')
    s += text(c1 + 62, 62, 'f(y|"1")', style='i')
    s += text(c0, 220, '0') + text(c1, 220, 'E₁', style='i')
    s += text(508, 220, 'y', anchor='end', style='i')
    s += text(205, 190, 'P(e|s₂)', size=12, color='#c0392b')
    s += text(335, 190, 'P(e|s₁)', size=12, color='#c0392b')
    return s + '</svg>'


def fig_q8chan():
    s = HEAD.format(w=470, h=290) + marker('arE')
    xy = {'0': (80, 70), '1': (80, 140), '2': (80, 210)}
    for k, (x, y) in xy.items():
        s += dot(x, y, 5)
        s += text(x - 14, y + 5, f'X={k}', anchor='end', style='i')
        s += text(x - 14, y + 23, 'P=1/3', anchor='end', size=12, color='#555')
    yy = {'0': 70, '1': 145, '2': 220}
    for k, y in yy.items():
        s += dot(340, y, 5) + text(356, y + 5, f'Y={k}', anchor='start', style='i')
    s += dot(340, 270, 5) + text(356, 275, 'Y=3', anchor='start', style='i')
    for k in ('0', '1', '2'):
        sy = xy[k][1]
        s += line(86, sy, 333, yy[k], marker='arE')
        s += text((86 + 333) / 2 - 16, (sy + yy[k]) / 2 - 6, '1/2', size=12, color='#c0392b')
        s += line(86, sy, 333, 270, marker='arE', color='#888')
        s += text((86 + 333) / 2 + 16, (sy + 270) / 2 + 4, '1/2', size=12, color='#c0392b')
    for k, y in yy.items():
        s += text(424, y + 5, '1/6', anchor='start', size=12, color='#555')
    s += text(424, 275, '1/2', anchor='start', size=12, color='#555')
    return s + '</svg>'


def fig_q7quant():
    s = HEAD.format(w=740, h=250) + marker('arF')
    X0, XS, YB = 60, 35, 195

    def mx(v):
        return X0 + (v + 4) * XS

    s += line(X0 - 12, YB, 350, YB, marker='arF') + text(356, YB + 5, 'x', anchor='start', style='i')
    s += line(mx(0), YB, mx(0), 75, marker='arF')
    s += poly([(mx(-4), YB), (mx(0), 95), (mx(4), YB)], close=True, fill='#f5f5f5')
    s += text(mx(0) - 8, 90, '1/4', anchor='end')
    for v in (-4, -2, 2, 4):
        s += line(mx(v), YB, mx(v), YB + 5) + text(mx(v), YB + 22, str(v))
    s += text(mx(0), YB + 22, '0') + text(mx(0) - 34, 130, 'p(x)', style='i')
    X1, XS2 = 420, 35

    def mx2(v):
        return X1 + (v + 4) * XS2

    yb, ya, y_aa, y_ab = 80, 120, 160, 200
    s += line(X1 - 12, y_ab, 710, y_ab, marker='arF') + text(716, y_ab + 5, 'x', anchor='start', style='i')
    s += line(mx2(0), y_ab, mx2(0), 55, marker='arF')
    s += line(mx2(0), y_aa, mx2(0) + XS2 * 4 + 6, y_aa, color='#bbb', dash='2,3')
    s += line(mx2(0), ya, mx2(0) - XS2 * 2 - 6, ya, color='#bbb', dash='2,3')
    s += poly([(mx2(-4), y_ab), (mx2(-2), y_ab), (mx2(-2), y_aa), (mx2(0), y_aa),
               (mx2(0), ya), (mx2(2), ya), (mx2(2), yb), (mx2(4), yb)])
    for v in (-2, 2):
        s += line(mx2(v), yb - 5, mx2(v), y_ab + 5, color='#999', dash='3,3')
    s += dot(mx2(-2), y_ab, 3.5) + dot(mx2(-2), y_aa, 3.5, fill='#fff', stroke='#1a1a1a')
    s += dot(mx2(0), y_aa, 3.5) + dot(mx2(0), ya, 3.5, fill='#fff', stroke='#1a1a1a')
    s += dot(mx2(2), ya, 3.5) + dot(mx2(2), yb, 3.5, fill='#fff', stroke='#1a1a1a')
    for yy2, nm in ((yb, 'b'), (ya, 'a'), (y_aa, '−a'), (y_ab, '−b')):
        s += text(X1 - 20, yy2 + 5, nm, anchor='end', style='i')
    for v in (-4, -2, 2, 4):
        s += text(mx2(v), y_ab + 22, str(v))
    s += text(mx2(0), y_ab + 22, '0') + text(mx2(0) - 44, 70, 'Y=Q(x)', style='i')
    return s + '</svg>'


def fig_q2psd():
    s = HEAD.format(w=380, h=190) + marker('arG')
    s += line(40, 150, 340, 150, marker='arG') + text(348, 155, 'f', anchor='start', style='i')
    s += line(190, 150, 190, 40, marker='arG')
    s += poly([(90, 150), (90, 60), (290, 60), (290, 150)], fill='#f5f5f5')
    s += text(84, 56, 'N₀/2', anchor='end', style='i')
    s += text(90, 168, '−B') + text(290, 168, 'B') + text(196, 168, '0', anchor='start')
    s += text(190, 30, 'P_nB(f)', style='i')
    return s + '</svg>'


def fig_q3psd():
    s = HEAD.format(w=480, h=190) + marker('arH')
    s += line(30, 150, 450, 150, marker='arH') + text(458, 155, 'f', anchor='start', style='i')
    s += line(240, 150, 240, 40, marker='arH')

    def imp(x, h, w):
        return (line(x, 150, x, 150 - h)
                + f"<polygon points='{x - 4},{150 - h + 9} {x + 4},{150 - h + 9} {x},{150 - h}' fill='#1a1a1a'/>"
                + text(x, 150 - h - 6, w, size=12))

    s += imp(140, 70, '1') + imp(340, 70, '1')
    s += imp(95, 32, '1/4') + imp(385, 32, '1/4')
    for x, t in ((95, '−900'), (140, '−400'), (240, '0'), (340, '400'), (385, '900')):
        s += text(x, 168, t, size=12)
    s += text(240, 30, 'P_m(f)', style='i')
    return s + '</svg>'


def sinc(x):
    return 1.0 if abs(x) < 1e-9 else math.sin(math.pi * x) / (math.pi * x)


def fig_q4x():
    X0, TSP, Y0, SC = 200, 80, 150, 70
    s = HEAD.format(w=560, h=245) + marker('arI')
    s += line(20, Y0, 540, Y0, marker='arI') + text(548, Y0 + 5, 't', anchor='start', style='i')
    pts = []
    t = -2.4
    while t <= 3.55:
        v = sinc(t) - sinc(t - 2)
        pts.append((X0 + t * TSP, Y0 - v * SC))
        t += 0.05
    s += poly(pts, width=2)
    for k in (-2, -1, 0, 1, 2, 3):
        x = X0 + k * TSP
        s += line(x, Y0 - 4, x, Y0 + 4)
        lbl = ('−' + str(-k) + 'T_s') if k < 0 else ('0' if k == 0 else (str(k) + 'T_s'))
        s += text(x, Y0 + 20, lbl, size=12)
    s += dot(X0, Y0 - SC, 4.5) + text(X0 + 10, Y0 - SC - 6, 'x(0)=1', anchor='start', size=12, style='i')
    s += dot(X0 + 2 * TSP, Y0 + SC, 4.5) + text(X0 + 2 * TSP + 10, Y0 + SC + 14, 'x(2T_s)=−1', anchor='start', size=12, style='i')
    for k in (-2, -1, 1, 3):
        s += dot(X0 + k * TSP, Y0, 3.5, fill='#fff', stroke='#1a1a1a')
    return s + '</svg>'


# (key, 题号, 是否解析配图, 描述)。题目原图放 data/figures/<年>/，解析配图放 answer/ 子目录。
# 文件名统一"年份-题号-图名"；题目数据里仍用 fig: "key" 引用（与文件名解耦）。
FIGS = [
    ('ssb', '三', False, 'SSB相干解调框图'),
    ('pam', '四', False, 'PAM系统框图'),
    ('encoder', '九', False, '两级编码器框图'),
    ('q2psd', '二', True, '带限白噪声功率谱'),
    ('q3psd', '三', True, 'm(t)功率谱线'),
    ('q4x', '四', True, 'A→B冲激响应x(t)'),
    ('ookpdf', '五', True, 'OOK最佳判决PDF'),
    ('psk8', '六', True, '8PSK星座与判决域'),
    ('psk8new', '六', True, '8PSK新星座(内圆r=1/2)'),
    ('q7quant', '七', True, '量化特性曲线'),
    ('q8chan', '八', True, '信道转移图'),
]
SVGS = {
    'ssb': fig_ssb(), 'pam': fig_pam(), 'encoder': fig_encoder(),
    'psk8': fig_psk8(), 'psk8new': fig_psk8new(), 'ookpdf': fig_ookpdf(),
    'q8chan': fig_q8chan(), 'q7quant': fig_q7quant(), 'q2psd': fig_q2psd(),
    'q3psd': fig_q3psd(), 'q4x': fig_q4x(),
}

# 每张图一个文件；输出用 ###FILE: 分隔，落盘用 node tools/emit_figures.mjs 2025。
# 页面加载由 app/scripts/sync-data.mjs 把目录（不含 _ 前缀文件）合并成 public/data/figures/<年>.js。
YEAR = '2025'
requires = []
for key, qnum, is_ans, desc in FIGS:
    sub = 'answer/' if is_ans else ''
    fname = YEAR + '-' + qnum + '-' + key + '.js'
    requires.append('./' + sub + fname)
    kind = '解析配图' if is_ans else '题目原图'
    meta_kind = 'answer' if is_ans else 'paper'
    print('###FILE:data/figures/' + YEAR + '/' + sub + fname)
    print('// ' + YEAR + ' · 题' + qnum + ' ' + kind + ' · ' + desc + ' —— 由 tools/gen_figures_' + YEAR + '.py 生成，勿手改')
    print('window.BUPT801 = window.BUPT801 || {};')
    print('window.BUPT801.figures = window.BUPT801.figures || {};')
    print('(window.BUPT801.figures["' + YEAR + '"] = window.BUPT801.figures["' + YEAR + '"] || {}).' + key + ' = ' + repr(SVGS[key]) + ';')
    print('window.BUPT801.figureMeta = window.BUPT801.figureMeta || {};')
    print('(window.BUPT801.figureMeta["' + YEAR + '"] = window.BUPT801.figureMeta["' + YEAR + '"] || {}).' + key + ' = { q: "题' + qnum + '", kind: "' + meta_kind + '", desc: "' + desc + '" };')

# Node 端索引（server/校验器加载用；以 _ 开头，不进浏览器 bundle）
print('###FILE:data/figures/' + YEAR + '/_index.js')
print('// ' + YEAR + ' 图库索引 —— 由 tools/gen_figures_' + YEAR + '.py 生成；Node 端 require 用，不进浏览器 bundle')
for r in requires:
    print('require("' + r + '");')
