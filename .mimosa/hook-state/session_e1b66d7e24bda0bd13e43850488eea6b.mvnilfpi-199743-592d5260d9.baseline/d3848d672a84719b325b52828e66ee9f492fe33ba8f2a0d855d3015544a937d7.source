      "options7": {
        "A": "7",
        "B": "10",
        "C": "13",
        "D": "16"
      }
    },
    "g3": {
      "stem": "给定到达接收端的已调信号功率 $P_R$、单边噪声功率谱密度 $N_0$、基带信号的带宽 $W$。若 DSB-SC 解调输出信噪比为 30 dB，则 SSB 解调输出信噪比为（8） dB，调制效率为 10% 的 AM 非相干解调输出信噪比约为（9） dB。",
      "options": {
        "A": "10",
        "B": "20",
        "C": "30",
        "D": "40"
