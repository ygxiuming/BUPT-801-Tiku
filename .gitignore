# 依赖（体积大，用 npm install 恢复）
node_modules/

# 前端产物与开发快照（由 npm run sync / npm run build 生成，不入库）
app/dist/
app/public/data/
app/public/vendor/

# 临时与系统文件
*.log
.DS_Store
Thumbs.db
/tmp/

# 工具运行时的审计账本（每次调用都会写，纯噪音）
.mimosa/

# Python 运行缓存（gen_figures_*.py 导入 svgkit 时生成）
__pycache__/

# 编辑器/助手的私有工作目录（含本机路径与技术笔记，不对外）
.workbuddy/
.zcode/
